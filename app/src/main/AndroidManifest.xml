<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <queries>
        <package android:name="com.mbmobile" />
        <package android:name="com.mrtien.mbbankguard" />
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_toggle_accessibility"
        android:label="@string/toggle_accessibility_name"
        android:roundIcon="@drawable/ic_toggle_accessibility"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Màn hình cài đặt vẫn tồn tại nhưng KHÔNG tạo icon riêng ngoài màn hình. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".LocalAdbPermissionActivity"
            android:exported="false"
            android:label="Cấp quyền trên điện thoại" />

        <!-- Giữ chức năng MỞ APP AN TOÀN để tương thích dữ liệu cũ,
             nhưng KHÔNG còn là launcher icon. -->
        <activity
            android:name=".SafeLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:label="@string/safe_launcher_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.mrtien.mbbankguard.safe"
            android:theme="@style/TransparentLaunchTheme" />

        <!-- DUY NHẤT activity này có MAIN/LAUNCHER: ngoài màn hình chỉ có 1 icon. -->
        <activity
            android:name=".ToggleAccessibilityActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:icon="@drawable/ic_toggle_accessibility"
            android:label="@string/toggle_accessibility_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:roundIcon="@drawable/ic_toggle_accessibility"
            android:taskAffinity="com.mrtien.mbbankguard.toggle"
            android:theme="@style/TransparentLaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Nhấn giữ icon -> CÀI ĐẶT MB GUARD, không tạo thêm icon ngoài màn hình. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".RecoveryWatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Chỉ chạy tạm thời sau thao tác người dùng để phát hiện khi thoát ứng dụng ngân hàng và khôi phục Accessibility đã tắt." />
        </service>
    </application>
</manifest>
