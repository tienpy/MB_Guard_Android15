<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <queries>
        <package android:name="com.mbmobile" />
        <package android:name="com.mrtien.mbbankguard" />
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_toggle_accessibility_off"
        android:label="@string/toggle_accessibility_name"
        android:roundIcon="@drawable/ic_toggle_accessibility_off"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Màn hình cài đặt không tạo icon riêng. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".LocalAdbPermissionActivity"
            android:exported="false"
            android:label="Cấp quyền trên điện thoại" />

        <!-- Giữ logic cũ ở bên trong, không có launcher icon. -->
        <activity
            android:name=".SafeLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:label="@string/safe_launcher_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.mrtien.mbbankguard.safe"
            android:theme="@style/TransparentLaunchTheme" />

        <!-- Activity thật không có MAIN/LAUNCHER. Hai alias bên dưới thay nhau hiển thị
             ở CÙNG một vị trí với cùng một tên, chỉ khác màu icon. -->
        <activity
            android:name=".ToggleAccessibilityActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:label="@string/toggle_accessibility_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.mrtien.mbbankguard.toggle"
            android:theme="@style/TransparentLaunchTheme" />

        <!-- OFF là trạng thái mặc định an toàn khi mới cài/chưa cấu hình. -->
        <activity-alias
            android:name=".ToggleAccessibilityOffAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_toggle_accessibility_off"
            android:label="@string/toggle_accessibility_name"
            android:roundIcon="@drawable/ic_toggle_accessibility_off"
            android:targetActivity=".ToggleAccessibilityActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".ToggleAccessibilityOnAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_toggle_accessibility_on"
            android:label="@string/toggle_accessibility_name"
            android:roundIcon="@drawable/ic_toggle_accessibility_on"
            android:targetActivity=".ToggleAccessibilityActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <service
            android:name=".RecoveryWatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Chỉ chạy tạm thời sau thao tác người dùng để phát hiện khi thoát ứng dụng ngân hàng và khôi phục Accessibility đã tắt." />
        </service>
    </application>
</manifest>
